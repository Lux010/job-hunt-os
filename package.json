{
  "name": "job-hunt-os",
  "version": "1.0.0",
  "description": "Monolithic MERN job application tracker with AI-powered JD fit scoring and follow-up email reminders.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n server,client -c cyan,magenta \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm run build && node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "mongodb-memory-server": "^11.2.0"
  }
}
