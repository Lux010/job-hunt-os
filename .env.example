# Server
PORT=5000
# Optional: local MongoDB or Atlas connection string. If unset, an ephemeral
# in-memory MongoDB is started automatically (great for local demo).
MONGODB_URI=mongodb://127.0.0.1:27017/jobhuntos
JWT_SECRET=change-me-in-production

# Optional: AI fit scoring via any OpenAI-compatible endpoint.
# If unset, a keyword-based matcher is used instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: follow-up email reminders (SMTP). Digest is logged to console if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REMINDER_CRON=0 9 * * *
REMINDER_AFTER_DAYS=7
